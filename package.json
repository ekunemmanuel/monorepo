{
    "name": "monorepo-template",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "bun x turbo build",
        "dev": "bun x turbo dev",
        "lint": "bun x turbo lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "desktop": "bun x turbo run desktop --filter=@monorepo/desktop",
        "web": "bun x turbo run dev --filter=@monorepo/web",
        "mobile": "bun x turbo run dev --filter=@monorepo/mobile"
    },
    "devDependencies": {
        "turbo": "^2.9.9",
        "prettier": "^3.8.3"
    },
    "packageManager": "bun@1.3.5"
}